+#: Intensity acceptance is a statistical claim about a thinned Poisson
+#: process, so its resolution is declared BEFORE any measurement:
+#:   * the declaration is checked against the rate it would produce if the
+#:     burst transform were silently NOT applied (multiplier 1);
+#:   * the test is only DECIDABLE when the two expected counts are separated
+#:     by more than INTENSITY_SIGMA standard deviations of each
+#:     (E_burst - E_base > sigma*sqrt(E_burst) + sigma*sqrt(E_base));
+#:   * otherwise the verdict is UNDECIDABLE and the report says so.  One packet
+#:     inside the window is never reported as intensity acceptance.
+INTENSITY_SIGMA = 3.0
+
+
+def _poisson_band(mean: float) -> float:
+    """Half-width of the declared INTENSITY_SIGMA band around a Poisson mean."""
+    return INTENSITY_SIGMA * math.sqrt(mean)
+
+
+def _burst_intensity(resolved: dict, start: float, window_end: float,
+                     inside: list[dict]) -> dict:
+    """Compare the realized in-window count against the declared multiplier.
+
+    The generator is an exact thinning of a Poisson process: candidates are
+    proposed at base_rate * max(1, multiplier) and accepted with probability
+    multiplier(t) / max(1, multiplier), so the accepted rate is
+    base_rate * multiplier(t) with multiplier(t) piecewise constant (multiplier
+    inside the window, 1 outside).  The expected in-window count is therefore
+    exactly total_rate * multiplier * window length, which makes the declared
+    intensity a falsifiable prediction instead of a label.  The nested family
+    scales by its inclusion probability, which is likewise exact (one
+    independent Bernoulli draw per master candidate).
+    """
+    dm = resolved["config"]["demand"]
+    if dm["mode"] == "csv":
+        return {"status": "NOT_APPLICABLE",
+                "reason": ("csv demand is replayed verbatim; there is no "
+                           "generator rate for the declaration to be compared "
+                           "against")}
+    width = window_end - start
+    effective_multiplier = max(1.0, float(dm["burst_multiplier"]))
+    generation_mbps = (float(dm["nested_master_offered_mbps"])
+                       if dm["nested_master_offered_mbps"] is not None
+                       else float(dm["offered_mbps"]))
+    total_rate = generation_mbps * 1e6 / int(dm["packet_bits"])
+    inclusion = (1.0 if dm["nested_master_offered_mbps"] is None
+                 else float(dm["offered_mbps"])
+                 / float(dm["nested_master_offered_mbps"]))
+    expected_burst = total_rate * effective_multiplier * width * inclusion
+    expected_base = total_rate * width * inclusion
+    observed = len(inside)
+    separation = expected_burst - expected_base
+    sigma_span = (_poisson_band(expected_burst) + _poisson_band(expected_base)
+                  if expected_burst > 0 else float("inf"))
+    report = {
+        "sigma": INTENSITY_SIGMA,
+        "window_width_s": width,
+        "expected_packets_if_burst_applied": expected_burst,
+        "expected_packets_if_burst_not_applied": expected_base,
+        "observed_packets": observed,
+        "observed_over_expected_burst": (observed / expected_burst
+                                         if expected_burst > 0 else None),
+        "required_separation": sigma_span,
+        "predicted_separation": separation,
+    }
+    if effective_multiplier <= 1.0:
+        report["status"] = "UNVERIFIABLE"
+        report["reason"] = ("burst_multiplier <= 1 leaves the rate unchanged, "
+                            "so there is no intensity to verify")
+        return report
+    if not math.isfinite(sigma_span) or separation <= sigma_span:
+        report["status"] = "UNDECIDABLE"
+        report["reason"] = (
+            f"the declaration predicts {expected_burst:.3f} packets inside the "
+            f"window and {expected_base:.3f} if the burst were not applied; "
+            f"separating those at {INTENSITY_SIGMA} sigma needs more than "
+            f"{sigma_span:.3f} and the gap is {separation:.3f}. A non-empty "
+            "window is NOT evidence that the declared intensity happened")
+        return report
+    if abs(observed - expected_burst) > _poisson_band(expected_burst):
+        report["status"] = "VIOLATED"
+        report["reason"] = (
+            f"{observed} packets inside the window against an expected "
+            f"{expected_burst:.3f} +/- {_poisson_band(expected_burst):.3f} "
+            f"({INTENSITY_SIGMA} sigma); the declared multiplier "
+            f"{dm['burst_multiplier']} did not materialize")
+        return report
+    report["status"] = "VERIFIED"
+    return report
 
 
