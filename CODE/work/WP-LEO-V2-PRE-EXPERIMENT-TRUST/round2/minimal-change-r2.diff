+        binding = "v6 digests recomputed from this copy"
+    elif schema is not None:
+        binding = ("v5: no digest is bound, so the downgrade is checked for "
+                   "contradiction"
+                   + (" and required to be the empty-decision case"
+                      if require_streams else
+                      " (streams not required for this directory)"))
+    else:
+        binding = "not evaluated: no readable receipt"
+    stream_errors = receipt_mod.verify_receipt_streams(
+        str(run_dir), require_streams=bool(require_streams))
+    check("P4",
+          "the stream contract holds (v6 digests recomputed HERE, not "
+          "trusted from the VM run)",
+          not stream_errors, require_streams=bool(require_streams),
+          stream_binding=binding, errors=stream_errors)
+
+    governance = None
+    if is_formal:
+        try:
+            witness = _read_json(formal, FORMAL_WITNESS)
+            governance = _read_json(run_dir / GOVERNANCE_RECEIPT,
+                                    GOVERNANCE_RECEIPT)
+        except PullbackError as exc:
+            check("P5", "the formal witness and governance receipt are present "
+                        "and readable", False, why=str(exc))
+        else:
+            formal_errors: list[str] = []
+            receipt_sha = _sha256(run_dir / "receipt.json")
+            if witness.get("receipt_sha256") != receipt_sha:
+                formal_errors.append(
+                    "formal_run.json receipt_sha256 does not match this copy's "
+                    f"receipt.json (witness {witness.get('receipt_sha256')!r}, "
+                    f"copy {receipt_sha})")
+            if governance.get("research_eligible") is not True:
+                formal_errors.append(
+                    "governance_receipt.research_eligible is not true")
+            verification_errors = governance.get("verification_errors")
+            if verification_errors != []:
+                formal_errors.append(
+                    "governance_receipt.verification_errors is not empty: "
+                    f"{verification_errors!r}")
+            for field, name in sorted(GOVERNANCE_BINDINGS.items()):
+                path = run_dir / name
+                if path.is_symlink() or not path.is_file():
+                    formal_errors.append(
+                        f"{field}: {name} is missing from the result set")
+                    continue
+                actual = _sha256(path)
+                if governance.get(field) != actual:
+                    formal_errors.append(
+                        f"governance_receipt.{field} does not match this copy's "
+                        f"{name} (recorded {governance.get(field)!r}, copy "
+                        f"{actual})")
+            check("P5", "the formal increment agrees with this copy "
+                        "(witness, eligibility, every governance hash)",
+                  not formal_errors, errors=formal_errors)
+    else:
+        check("P5", "no formal_run.json, so no formal increment is claimed",
+              True, skipped=True)
+
+    local_code = receipt_mod.code_sha256()
+    runtime_code = None if receipt is None else receipt.get("code_sha256")
+    identity = {
+        "runtime_code_sha256": runtime_code,
+        "local_code_sha256": local_code,
+        "runtime_equals_local": runtime_code == local_code,
+        "note": ("reported for the record only: this checker deliberately does "
+                 "not require the local checkout to equal the run-time "
+                 "identity, so a false here is expected for a VM run and is "
+                 "not an error"),
