+    return {
+        "schema": SCHEMA,
+        "run_dir": str(run_dir),
+        "formal_run": is_formal,
+        "require_streams": bool(require_streams),
+        "receipt_schema": None if receipt is None else receipt.get("schema"),
+        "run_id": None if receipt is None else receipt.get("run_id"),
+        "runtime_identity": identity,
+        "checks": checks,
+        "errors": errors,
