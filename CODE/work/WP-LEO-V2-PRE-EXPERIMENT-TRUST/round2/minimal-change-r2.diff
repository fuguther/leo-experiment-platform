+def test_a_declared_intensity_that_did_not_materialize_is_violated():
+    """The predicate itself, with a synthetic count far from the declaration."""
+    resolved = _burst_cfg()
+    starved = [{}] * 20  # 20 observed against 250 expected at 3 sigma
+    intensity = trace_mod._burst_intensity(resolved, 10.0, 20.0, starved)
+    assert intensity["status"] == "VIOLATED"
+    assert "did not materialize" in intensity["reason"]
+
+    # …and the compile refuses the trace that produced it
+    rows = [{"packet_id": index, "emit_time_s": 0.5 * index,
