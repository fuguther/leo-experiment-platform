+"""Local acceptance of a PULLED-BACK result directory.
+
+WHY THIS EXISTS
+===============
+The formal chain verifies a run on the VM, at the moment it finishes, over the
+files on the VM's own filesystem.  That verdict is not transferable: the pull
+that brings the results home (CODE/scripts/remote/pull-results-remote.sh) is a
+tar over ssh that copies a fixed list of files and, by construction, tolerates
+files that are not there (add_file returns silently when a path is absent).  So
+"the VM verified it" and "the copy I am holding is the copy that was verified"
+are two different statements, and only the second one is about the artifacts an
+analysis will actually read.
+
+This module makes the second statement checkable.  It is deliberately separate
+from receipt.verify_receipt_dir: that function's strict mode requires the LOCAL
+analyzer source and dependency versions to equal the recorded run-time
+identity, which can only ever fail for a run produced on another machine.  Here
+the questions are:
+
+  1. is the required artifact set present at all (EXPERIMENTS/contracts/
+     run-artifact-contract.md, "leo_sim_v2 核心结果文件" + formal increment)?
+  2. does every hash the receipt binds still match the files on disk?
+  3. does the stream contract hold -- and for a v6 receipt that means the two
+     recorded digests are RECOMPUTED here, not trusted from the VM run?
+  4. if the run claims to be formal, do the formal witness and the governance
+     receipt agree with this copy?
+
+WHAT IT DOES NOT DO
+===================
+It does not re-run the simulation, it does not re-derive the run-time identity,
+and an ok verdict is not authorization and not a claim.  A directory that fails
+any check is reported, never repaired.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from . import receipt as receipt_mod
+
+SCHEMA = "leo-sim-pullback-verification/v1"
+
+#: leo_sim_v2 core result files.  Written by the run CLI itself, so a pulled
+#: result set missing any of them cannot be analyzed at all.
+REQUIRED_CORE_FILES = ("receipt.json", "resolved_config.json", "manifest.json",
+                       "trace.csv", "ledgers.json")
+
+#: The formal governance increment.  Required only when formal_run.json is
+#: present, i.e. when the directory CLAIMS to be a formal run.
+FORMAL_WITNESS = "formal_run.json"
+GOVERNANCE_RECEIPT = "governance_receipt.json"
+
+#: Governance fields that must agree with the copy being verified.
+GOVERNANCE_BINDINGS = {
+    "run_receipt_sha256": "receipt.json",
+    "resolved_config_sha256": "resolved_config.json",
+    "trace_manifest_sha256": "manifest.json",
+}
+
+
+class PullbackError(ValueError):
+    """The directory cannot be verified as it stands."""
+
+
+def _sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _read_json(path: Path, label: str) -> dict:
+    if path.is_symlink() or not path.is_file():
+        raise PullbackError(f"{label} is missing or symbolic: {path}")
+    try:
+        value = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise PullbackError(f"{label} is unreadable: {exc}") from exc
+    if not isinstance(value, dict):
+        raise PullbackError(f"{label} must be a JSON object")
+    return value
+
+
+def verify_pulled_run(run_dir: str | Path, *,
+                      require_streams: bool | None = None) -> dict:
+    """Verify one pulled-back run directory.  Never raises for a bad result
+    set: every failure is reported as a failed check with its reason, so a
+    caller can always distinguish "verified" from "could not verify".
