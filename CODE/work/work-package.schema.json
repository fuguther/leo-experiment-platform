{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-work-package/v2",
  "title": "Versioned agent work package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "work_id",
    "revision",
    "parent_revision",
    "producer_id",
    "producer_session_id",
    "objective",
    "allowed_inputs",
    "excluded_inputs",
    "deliverables",
    "cannot_claim",
    "acceptance",
    "review_roles",
    "cost_tier",
    "status"
  ],
  "properties": {
    "schema": {"const": "agent-work-package/v2"},
    "work_id": {"type": "string", "pattern": "^WP-[A-Za-z0-9_-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "parent_revision": {"type": ["integer", "null"], "minimum": 1},
    "revision_reason": {"type": "string", "minLength": 1},
    "producer_id": {"type": "string", "pattern": "^producer:[A-Za-z0-9._-]+$"},
    "producer_session_id": {"type": "string", "pattern": "^P-[A-Za-z0-9._-]+$"},
    "objective": {"type": "string", "minLength": 10},
    "context": {"type": "array", "items": {"type": "string"}},
    "allowed_inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "excluded_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "cannot_claim": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "review_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cold_start",
          "satellite_drl",
          "research_governance",
          "adversarial",
          "paper_value",
          "claim_support",
          "claim_value"
        ]
      }
    },
    "cost_tier": {"enum": ["low", "standard", "high_judgment"]},
    "status": {
      "enum": ["DRAFT", "ASSIGNED", "IN_PROGRESS", "REVIEW", "REVISE", "ACCEPTED", "STOPPED"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"revision": {"const": 1}}},
      "then": {"properties": {"parent_revision": {"const": null}}},
      "else": {
        "required": ["revision_reason"],
        "properties": {"parent_revision": {"type": "integer", "minimum": 1}}
      }
    }
  ]
}
