# Copy this file to remote.env. remote.env is ignored by Git and is never deployed.
REMOTE_HOST_ALIAS="vm"
REMOTE_WORKSPACE_DIR="/data/论文/leo-direct-sim"
REMOTE_CODE_DIR="/data/论文/leo-direct-sim/CODE"

# Keep the VM's existing activation command. Current VM experiments use the
# non-default conda env at /data/liguang13/conda-envs/leo-i39; base lacks pandas.
REMOTE_ENV_ACTIVATE="source /opt/anaconda3/bin/activate /data/liguang13/conda-envs/leo-i39"

# Optional overrides
REMOTE_SESSION_PREFIX="leo"
# Runtime state and the deployment receipt live at workspace/.remote_runtime.
REMOTE_RUNTIME_DIR=".remote_runtime"
REMOTE_STATUS_FILE=".remote_runtime/current_status.json"
# Logs and all experiment results live only under workspace/CODE/Results.
REMOTE_LOG_DIR="Results/_overnight_logs"
REMOTE_PYTHON="python3"
