{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-claim/v2",
  "title": "Evidence-bound research claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "claim_id",
    "author_id",
    "author_session_id",
    "candidate_artifact",
    "statement",
    "claim_type",
    "status",
    "scope",
    "evidence",
    "limitations",
    "alternative_explanations",
    "support_gate",
    "value_gate"
  ],
  "properties": {
    "schema": {"const": "research-claim/v2"},
    "claim_id": {"type": "string", "pattern": "^CL-[A-Za-z0-9_-]+$"},
    "author_id": {"type": "string", "pattern": "^producer:[A-Za-z0-9._-]+$"},
    "author_session_id": {"type": "string", "pattern": "^P-[A-Za-z0-9._-]+$"},
    "candidate_artifact": {"$ref": "#/$defs/artifact"},
    "statement": {"type": "string", "minLength": 10},
    "claim_type": {
      "enum": [
        "HYPOTHESIS",
        "OBSERVATION",
        "EXPERIMENT_RESULT",
        "MECHANISM_EXPLANATION",
        "NEGATIVE_RESULT",
        "SCOPE_BOUNDARY"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "HYPOTHESIS",
        "OBSERVED",
        "SUPPORTED_LIMITED",
        "SUPPORTED",
        "REFUTED",
        "SUPERSEDED",
        "UNKNOWN"
      ]
    },
    "scope": {"type": "string", "minLength": 10},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 10}
    },
    "alternative_explanations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 10}
    },
    "support_gate": {"$ref": "#/$defs/support_gate"},
    "value_gate": {"$ref": "#/$defs/value_gate"},
    "supersedes": {"type": ["string", "null"], "pattern": "^CL-[A-Za-z0-9_-]+$"}
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\n]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^ANALYSIS/(?:[^/\\n]+/)*analysis-manifest\\.json$"
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_kind", "artifact", "supports"],
      "properties": {
        "evidence_id": {"type": "string", "pattern": "^EV-[A-Za-z0-9_-]+$"},
        "evidence_kind": {"const": "VERIFIED_ANALYSIS"},
        "artifact": {"$ref": "#/$defs/evidence_artifact"},
        "supports": {"type": "string", "minLength": 10}
      }
    },
    "support_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "path",
        "sha256",
        "reviewer_id",
        "reviewer_session_id",
        "role",
        "verdict",
        "subject_sha256"
      ],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^RR-SUPPORT-[A-Za-z0-9_-]+$"},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?:.*/)?support-[^/\\n]+\\.json$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "reviewer_id": {"type": "string", "pattern": "^reviewer:[A-Za-z0-9._-]+$"},
        "reviewer_session_id": {"type": "string", "pattern": "^R-[A-Za-z0-9._-]+$"},
        "role": {"const": "claim_support"},
        "verdict": {"const": "PASS"},
        "subject_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "value_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "path",
        "sha256",
        "reviewer_id",
        "reviewer_session_id",
        "role",
        "verdict",
        "subject_sha256"
      ],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^RR-VALUE-[A-Za-z0-9_-]+$"},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?:.*/)?value-[^/\\n]+\\.json$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "reviewer_id": {"type": "string", "pattern": "^reviewer:[A-Za-z0-9._-]+$"},
        "reviewer_session_id": {"type": "string", "pattern": "^R-[A-Za-z0-9._-]+$"},
        "role": {"const": "claim_value"},
        "verdict": {"const": "PASS"},
        "subject_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "support_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["UNREVIEWED", "BLOCK", "LIMITED", "PASS"]},
        "receipt": {"$ref": "#/$defs/support_receipt"}
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "PASS"}}
          },
          "then": {"required": ["receipt"]}
        }
      ]
    },
    "value_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["UNREVIEWED", "LOW", "KEEP", "PROMOTE"]},
        "receipt": {"$ref": "#/$defs/value_receipt"}
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"enum": ["KEEP", "PROMOTE"]}}
          },
          "then": {"required": ["receipt"]}
        }
      ]
    }
  }
}
