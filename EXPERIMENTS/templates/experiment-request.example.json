    "completion_contract": [
      "natural_end=true",
      "interrupted=false",
      "run identity and config hash match the manifest",
      "all required artifacts exist",
      "artifact_manifest hashes every required artifact except itself"
    ]
  },
  "analysis": {
    "estimand": "同一 seed 下 higher_load 相对 control 的 delivery_rate 平均差",
    "unit_of_analysis": "seed-arm run",
